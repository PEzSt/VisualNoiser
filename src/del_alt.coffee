class Vertex
  constructor: (@x, @y) ->

grid_point = (vst, x, y, ofs) ->
      vst.push (new Vertex x, y)
      vst.push (new Vertex x-ofs, y)
      vst.push (new Vertex x, y)
      vst.push (new Vertex x, y-ofs)

tri_point = (vst, x, y, ofs) ->
      vst.push (new Vertex x, y)
      vst.push (new Vertex x-ofs, y)
      vst.push (new Vertex x, y+ofs)
      vst.push (new Vertex x, y)
      vst.push (new Vertex x+ofs, y+ofs)
      vst.push (new Vertex x, y+ofs)

example = () ->
  vs = []
  vs1 = []

  x_v = 20
  ofs = 0.2
  y_v = 20

  for y in [-x_v .. x_v]
    for x in [-y_v .. y_v]
            grid_point vs, x*ofs, y*ofs, ofs

  for y in [-x_v .. x_v]
    for x in [-y_v .. y_v]
            tri_point vs1, x*ofs, y*ofs, ofs

